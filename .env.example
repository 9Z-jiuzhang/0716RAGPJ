# ============================================
# 应用配置
# ============================================
APP_NAME=AI-KnowledgeBase-RAG
APP_VERSION=2.1.0
DEBUG=false
# local=本机联调；cloud=云端生产（启动强制校验密钥/CORS/PUBLIC_BASE_URL）
DEPLOYMENT_MODE=local
SECRET_KEY=<请填写>
# 公网根地址（无尾斜杠）。云端示例：https://kb.example.com ；本机可留空或 http://localhost:9080
PUBLIC_BASE_URL=
# 唯一超管账号 super 的密码（仅能通过此处修改；改后需重启 API）
SUPER_ADMIN_PASSWORD=Super123!
# 每次启动是否把 DB 中 super 密码同步为上面的值（云端首次引导后建议改为 false）
SUPER_ADMIN_SYNC_PASSWORD=true
# 是否播种演示账号 admin/staff_*（云端务必 false）
SEED_DEMO_USERS=true
# 是否开放 POST /auth/register（云端可 false）
AUTH_REGISTER_ENABLED=true
# 是否公开 /metrics（云端建议 false）
METRICS_PUBLIC=true

# ============================================
# 数据库 PostgreSQL
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=9543
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=<请填写>

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=9637
REDIS_DB=0
# 云端 docker-compose.prod.yml 要求设置；本机可留空
REDIS_PASSWORD=

# ============================================
# 向量数据库 Chroma
# ============================================
# 容器内固定监听 8000；本机 compose 宿主机映射为 9800（宿主机调试时改 CHROMA_PORT=9800）
# Compose 镜像固定 chromadb/chroma:1.5.5，须与 API 依赖 chromadb>=1.5,<2.0 一致（勿用 latest）
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ============================================
# 对象存储 MinIO
# ============================================
MINIO_ENDPOINT=minio:9900
MINIO_ACCESS_KEY=<请填写>
MINIO_SECRET_KEY=<请填写>
MINIO_BUCKET=knowledge-base-docs

# ============================================
# LLM 大模型（千问 / 百炼业务空间，OpenAI 兼容模式）
# ============================================
LLM_PROVIDER=dashscope
LLM_API_KEY=<请填写>
LLM_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 主回答开启思考：流式 reasoning_content 包装为 <think>，前端气泡展示并在结束后折叠
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=2048

# MarkItDown 导出看图（PDF/PPTX 等内嵌图表 → Markdown 描述；默认开启）
MARKITDOWN_LLM_ENABLED=true
# 须为支持 image_url 的多模态模型（勿用纯文本模型）
MARKITDOWN_LLM_MODEL=qwen-vl-plus
# 留空则复用上面的 LLM_BASE_URL / LLM_API_KEY
MARKITDOWN_LLM_BASE_URL=
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_TIMEOUT_SECONDS=180
MARKITDOWN_LLM_PROMPT=

# Guard 与 Query 预处理默认复用主 LLM；地址和密钥留空时继承主连接。
LLM_GUARD_MODEL=qwen3.7-plus
LLM_GUARD_BASE_URL=
LLM_GUARD_API_KEY=
LLM_GUARD_TIMEOUT_SECONDS=20
QA_QUERY_PROCESSING_MODEL=qwen3.7-plus
QA_QUERY_PROCESSING_BASE_URL=
QA_QUERY_PROCESSING_API_KEY=
QA_QUERY_PROCESSING_TIMEOUT_SECONDS=30

# ============================================
# Embedding 嵌入模型（千问）
# ============================================
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=<请填写>
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# Rerank 重排模型（千问 DashScope；密钥为空时自动降级为原始检索排序）
# ============================================
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_MODEL=qwen3-vl-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_TIMEOUT_SECONDS=30
RERANK_CANDIDATE_MULTIPLIER=4

# ============================================
# Langfuse 链路追踪（可选）
# ============================================
# 方式1：禁用（开发/测试推荐，避免刷 error）
# 注释掉 LANGFUSE_HOST / PUBLIC_KEY / SECRET_KEY 三行即可关闭业务侧上报
#
# 方式2：自建 Langfuse（生产推荐）
#   docker compose -f docker-compose.langfuse.yml up -d
#   浏览器打开 http://localhost:9310
#
# 方式3：Langfuse 云版（需有效账号与网络）
#   LANGFUSE_HOST=https://cloud.langfuse.com
#
# 业务 API 容器内访问自建 Web；浏览器打开 http://localhost:9310
LANGFUSE_HOST=http://langfuse-web:9310
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-change-me
LANGFUSE_SECRET_KEY=sk-lf-local-dev-change-me
LANGFUSE_NEXTAUTH_URL=http://localhost:9310
LANGFUSE_NEXTAUTH_SECRET=<请填写强随机>
LANGFUSE_SALT=<请填写>
LANGFUSE_ENCRYPTION_KEY=<请填写64位hex，openssl rand -hex 32>
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=<请填写>
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_REDIS_AUTH=<请填写>
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=<请填写>
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_MEDIA_PUBLIC_ENDPOINT=http://localhost:9910
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=<请填写>
LANGFUSE_INIT_ORG_ID=kb-org
LANGFUSE_INIT_ORG_NAME=KnowledgeBase
LANGFUSE_INIT_PROJECT_ID=kb-project
LANGFUSE_INIT_PROJECT_NAME=RAG Platform
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=<请填写>


# ============================================
# JWT 认证
# ============================================
JWT_SECRET_KEY=<请填写>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 逗号分隔；同域反代可写 PUBLIC_BASE_URL 同值。云端禁止 *
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# 外部数据源（只读）与开放 API
# ============================================
# Fernet 密钥或任意口令（与 JWT_SECRET_KEY 分离）；本地留空则由 SECRET_KEY 派生
DATA_SOURCE_ENCRYPTION_KEY=
# 生产(cloud)必须配置主机白名单，逗号分隔；本地可留空
DATA_SOURCE_ALLOWED_HOSTS=
DATA_SOURCE_ALLOWED_PORTS=
DATA_SOURCE_CONNECT_TIMEOUT_SECONDS=10
DATA_SOURCE_QUERY_TIMEOUT_SECONDS=30
DATA_SOURCE_MAX_PREVIEW_ROWS=100
DATA_SOURCE_MAX_PAGE_SIZE=500
DATA_SOURCE_MAX_IMPORT_ROWS=10000
DATA_SOURCE_MAX_IMPORT_BYTES=10485760
DATA_SOURCE_MAX_POOL_SIZE=5
DATA_SOURCE_ALLOW_SQLITE=true
# API Key 校验 Pepper（与 JWT 分离；本地可留空则回退 SECRET_KEY）
EXTERNAL_API_KEY_PEPPER=
EXTERNAL_API_DEFAULT_RATE_LIMIT=60
EXTERNAL_API_MAX_UPLOAD_BYTES=104857600

# ============================================
# 监控
# ============================================
GRAFANA_ADMIN_PASSWORD=<请填写>

# ============================================
# 日志
# ============================================
LOG_LEVEL=INFO
# LOG_DIR 默认项目根目录 data/logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ============================================
# 快照策略（产品手册 5.8.4）
# ============================================
SNAPSHOT_MAX_COUNT=50
SNAPSHOT_RETENTION_DAYS=90

# ============================================
# 智能问答与会话记忆（产品手册 5.6）
# ============================================
# 上下文窗口：保留最近 N 轮对话（一问一答计为 1 轮）
QA_CONTEXT_WINDOW=10
# Redis 热缓存 TTL（分钟），读写时续期
QA_SESSION_TTL_MINUTES=30
# 闲置超过该分钟数未问答 → PG 标为 expired 并清 Redis（历史仍可查看/继续提问）
QA_SESSION_IDLE_EXPIRE_MINUTES=30
# 后台扫描闲置会话间隔（秒）
QA_SESSION_EXPIRE_SWEEP_SECONDS=60
# 历史物理保留天数；超过后消息与空会话自动删除
QA_HISTORY_RETENTION_DAYS=7
# 单个注册用户或访客跨会话最多保留的问答轮数
QA_HISTORY_MAX_TURNS=20
# 后台历史清理扫描间隔（秒）
QA_HISTORY_RETENTION_SWEEP_SECONDS=300
# 默认检索策略：hybrid（推荐）| vector | fulltext
QA_DEFAULT_STRATEGY=hybrid
# 默认返回检索片段数量
QA_DEFAULT_TOP_K=5
# 上下文跟进问至少使用的 top_k（与默认取较大值）
QA_FOLLOWUP_TOP_K=5
# 跟进问合并上轮引文分段（粘性证据）
QA_STICKY_EVIDENCE_ENABLED=true
QA_STICKY_EVIDENCE_CAP=8
# 命中后补同文档邻段（标题/正文拆开）
QA_NEIGHBOR_CHUNKS_ENABLED=true
QA_NEIGHBOR_CHUNK_RADIUS=1
# 相关性得分阈值，低于此值的片段将被过滤
QA_RELEVANCE_THRESHOLD=0.3
# RRF 融合排序参数 k（Reciprocal Rank Fusion）
QA_RRF_K=60
# Query 改写：环境默认关闭；问答页可按请求传 rewrite_enabled 覆盖；未传时上下文追问可由业务路由临时开启
QA_QUERY_REWRITE_ENABLED=false
# 未命中 LLM 参考答案：默认关闭（prefer abstain）；仅白名单业务意图在开启后可写参考答
QA_FALLBACK_LLM_ENABLED=false
QA_FALLBACK_WEB_SEARCH_ENABLED=false
# ---------- 功能开关（默认保守；详见 .env 注释与 README §2.5） ----------
# 业务路由：问候/帮助/越界不进 KB；上一答案变换不重检索
CONVERSATION_ROUTER_V2_ENABLED=true
PREVIOUS_ANSWER_TRANSFORM_ENABLED=true
# Session V2：开启后双写 Redis Hash/List；读路径仍以 V1 为主
SESSION_STORE_V2_ENABLED=false
# 模型配置注册表：发布不可变版本 / 回滚；管理端「版本」「发布版本」依赖此开关
MODEL_CONFIG_REGISTRY_V2_ENABLED=false
# L2 精确缓存（Redis）；开启后问答成功回写，同 scope+问题可直答
QA_EXACT_CACHE_ENABLED=false
# L3 语义直答：需注入候选；观察模式只记日志不短路
QA_SEMANTIC_CACHE_ENABLED=false
QA_SEMANTIC_CACHE_OBSERVE_ONLY=true
QA_RETRIEVAL_CACHE_ENABLED=false
# QA 队列：仅观察入队，不替代同步 SSE
QA_QUEUE_ENABLED=false
# 周期任务外置 Scheduler/Worker（见 docker-compose.scale.yml）
SCHEDULER_EXTERNAL_ENABLED=false
ANALYTICS_PIPELINE_V2_ENABLED=true
VECTOR_DUAL_WRITE_ENABLED=false
VECTOR_SHADOW_READ_ENABLED=false
# 向量读提供方：chroma（默认）| alibaba（桩，禁止生产切读）
VECTOR_READ_PROVIDER=chroma
QA_SEMANTIC_SIMILARITY_THRESHOLD=0.80
QA_SEMANTIC_MIN_MARGIN=0.05
QA_SEMANTIC_MIN_QUALITY=0.60
MODEL_MAX_CONCURRENT_GENERATIONS=20
QA_MAX_QUEUE_WAIT_SECONDS=60
# Query 扩展：生成语义相近、关键词互补的候选查询
QA_QUERY_EXPANSION_ENABLED=false
QA_QUERY_EXPANSION_COUNT=1
# HyDE：生成假设文档，仅用于向量嵌入召回，不作为回答依据
QA_HYDE_ENABLED=false
QA_QUERY_PROCESSING_MAX_TOKENS=768
# ---------- 多模态检索（图/表/HTML）----------
MULTIMODAL_RAG_ENABLED=true
MULTIMODAL_SUMMARY_ENABLED=true
MULTIMODAL_VLM_ENABLED=true
VLM_MODEL=qwen-vl-plus
VLM_BASE_URL=
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=60
MULTIMODAL_TABLE_MAX_CHARS=3000
MULTIMODAL_SUMMARY_MAX_TOKENS=512
# 单文档表/图 LLM 摘要上限（超出用截断回退，避免大 HTML 拖慢入库/挤占问答）
MULTIMODAL_SUMMARY_MAX_LLM_BLOCKS=8
# 角色缓存知识库：默认每 7 天生成 20 个文档问题，并补充 5 个历史高频问题
ROLE_CACHE_DEFAULT_INTERVAL_DAYS=7
ROLE_CACHE_DOCUMENT_QUESTION_COUNT=20
ROLE_CACHE_HISTORY_QUESTION_COUNT=5
ROLE_CACHE_DOCUMENT_CHUNK_LIMIT=30
ROLE_CACHE_DOCUMENT_CHARS_PER_CHUNK=800
ROLE_CACHE_LLM_MAX_TOKENS=4096
# 周期调度器检查间隔（秒）；每个角色的实际检测周期由管理端配置
ROLE_CACHE_SCHEDULER_POLL_SECONDS=3600
# 过渡期：角色缓存停写，命中只读回退
ROLE_CACHE_WRITE_ENABLED=false
ROLE_CACHE_READONLY_FALLBACK=true
# 知识库 FAQ 主缓存（接口说明见 docs/API.md §12.1）
FAQ_MASTER_SWITCH=true
FAQ_GENERATION_ENABLED=true
FAQ_PER_DOCUMENT_COUNT=25
FAQ_PER_KB_LIMIT=500
FAQ_KB_DAILY_LIMIT=500
FAQ_QUALITY_THRESHOLD=0.7
FAQ_SIMILARITY_THRESHOLD=0.85
FAQ_REJECT_DISABLE_THRESHOLD=3
FAQ_REDIS_CACHE_TTL_SECONDS=900
# LLM Guard：本地高风险规则优先，无法明确归类时调用 LLM 意图分类器
LLM_GUARD_ENABLED=true
LLM_GUARD_CLASSIFIER_ENABLED=true
LLM_GUARD_BLOCK_THRESHOLD=0.65
# true 表示分类器不可用时拒绝请求；默认 false 保持可用性，本地恶意规则仍生效
LLM_GUARD_FAIL_CLOSED=false
LLM_GUARD_PREVIEW_MAX_CHARS=200
# RAGAS 评估（默认关闭 RAGAS 匿名遥测）
RAGAS_ENABLED=true
RAGAS_DO_NOT_TRACK=true
RAGAS_DEFAULT_SAMPLE_LIMIT=10
RAGAS_MAX_SAMPLE_LIMIT=50
RAGAS_MAX_CONTEXTS_PER_SAMPLE=10
RAGAS_CONTEXT_MAX_CHARS=3000
# 访客临时会话 Cookie/Header 标识有效期（分钟）
QA_GUEST_SESSION_TTL_MINUTES=30
# Redis 逻辑库编号
REDIS_DB=0
# Chroma 多租户标识（Client-Server 模式）
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
